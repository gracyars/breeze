# Breeze — variáveis de ambiente
#
# Copie para `.env.local` (dev) ou configure como env vars no provedor (Vercel/CI).
# NUNCA commitar `.env`, `.env.local` ou qualquer arquivo com segredo real — o .gitignore já
# bloqueia `.env*` exceto este `.env.example`. Segredos de produção vivem só no painel da
# Vercel/Supabase e no Secrets do GitHub Actions, nunca em texto no repositório.

# ---------------------------------------------------------------------------
# Supabase — projeto (público, exposto ao browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role. Só no servidor (Server Actions, worker, scripts de backup).
# Bypassa RLS — nunca expor ao client, nunca logar.
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão Postgres direta, usada por `pg_dump` (scripts/backup.sh) e por migrações
# fora do CLI quando necessário. Formato: postgres://user:pass@host:port/db
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Autenticação — pepper do cpf_hash (SPEC §2.1, §7)
# ---------------------------------------------------------------------------
# HMAC-SHA256 pepper usado para derivar `pessoas.cpf_hash` a partir do CPF em claro no momento
# do lookup de login. Requisito de arquitetura: o pepper vive FORA do banco, só em variável de
# ambiente do servidor — nunca em coluna, nunca em migração, nunca commitado. Se vazar junto com
# um dump do banco, o cpf_hash deixa de ser opaco (CPF é enumerável — ver SPEC §2.1). Rotação
# exige reprocessar `cpf_hash` de toda a tabela `pessoas` em uma migração de dados dedicada.
# Gerar com: openssl rand -hex 32
CPF_HASH_PEPPER=

# ---------------------------------------------------------------------------
# LLM / OCR — extração, classificação, embeddings, síntese com citação (SPEC §3, §4, §6.2)
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_PROVIDER=
# Modelo barato para classificação de documento (SPEC §3.5) — não usar modelo caro por padrão.
LLM_MODEL_CLASSIFICACAO=
# Modelo para síntese com citação (SPEC §4) — grounding estrito, sem síntese de valor financeiro.
LLM_MODEL_SINTESE=
# Provedor de OCR condicional (ADR-6) — chamado só quando a heurística de página exige.
OCR_API_KEY=
OCR_PROVIDER=

# Teto de custo mensal de LLM em BRL (centavos), e limiar de alerta antes de bater o teto.
# Mecanismo e runbook de alerta: ver docs/ops/backup.md (seção "Teto de custo de LLM").
LLM_MONTHLY_BUDGET_CENTS=6000
LLM_BUDGET_ALERT_THRESHOLD_PCT=80
# Webhook (Slack/e-mail/etc.) para onde o alerta de teto é enviado — escala ao orquestrador/dona
# do projeto, nunca corta funcionalidade sozinho.
LLM_BUDGET_ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Backup (scripts/backup.sh, docs/ops/backup.md)
# ---------------------------------------------------------------------------
# Credenciais da conta separada (provedor diferente do de produção) que recebe o pg_dump semanal
# e o espelho do Storage. Nunca a mesma conta/provedor do Supabase de produção.
BACKUP_STORAGE_PROVIDER=
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=
BACKUP_STORAGE_REGION=
# Chave de criptografia do dump antes do upload (dado pessoal em repouso fora do Supabase).
BACKUP_ENCRYPTION_KEY=
# Nomes dos remotos `rclone` (configurados uma vez via `rclone config`, credencial fora do git —
# ver docs/ops/backup.md). Origem = Supabase Storage de produção; destino = conta de backup.
BACKUP_RCLONE_REMOTE=breeze-backup
BACKUP_SUPABASE_STORAGE_REMOTE=breeze-prod-storage

# ---------------------------------------------------------------------------
# Vercel / deploy
# ---------------------------------------------------------------------------
VERCEL_URL=
VERCEL_ENV=

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca segredo real em texto
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local
/supabase/.branches
/supabase/.temp
/supabase/.env

# macOS
.DS_Store

# scratch/local
*.local

# acervo real do condomínio (PDFs com PII/financeiro) — nunca no controle de versão;
# entra pelo pipeline de upload (SPEC §3), não pelo git.
/Documentos do Condomínio/

# Artefatos de execução do Playwright
test-results/
playwright-report/
